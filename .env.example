PORT=8787
PORTAFLOW_HOST=127.0.0.1
PORTAFLOW_DB=.portaflow/portaflow.sqlite
PORTAFLOW_RPC=wss://test-node-v3.portaldot.dev
# Required on Vercel. Add your Atlas connection string in hosting secrets,
# never in source control. Local development uses SQLite if this is unset.
# MONGODB_URI=
MONGODB_DB=portaflow
# For custom-domain hosting, set the exact public origin:
# PORTAFLOW_ORIGIN=https://your-domain.example
# Render's generated public URL is detected automatically.
